[Unit]
Description=kyoten の定時便を毎晩起こす
Documentation=https://github.com/polidog/kyoten

[Timer]
# 03:00 に前日ぶんが確定してから走る。壁時計の予定にするのは、
# Persistent= が OnCalendar= のタイマーにしか効かないため
# （man systemd.timer）。ラップトップが夜に閉じていても、次に起きた
# ときに取り戻す。
OnCalendar=*-*-* 03:00:00
Persistent=true

# 分単位でずれても困らない。ずらしておくと、複数台で同じ時刻に
# API を叩きに行かずに済む。
AccuracySec=5min
RandomizedDelaySec=10min

# 複数台で走らせるとき、集める側が母艦より先に起きているほうが素材の
# 渡りがいい。ただし当てにはしない —— ノートが閉じていた夜もあるので、
# 揃っていない日は母艦が**書かずに待つ**（`machine.ts` の `appendLimit`）。
# 集める側に回す機械では、ここを 02:00 にしておくとよい。

[Install]
WantedBy=timers.target
